# Server
SERVER_PORT=1255
GIN_MODE=release

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=teslaapp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Region: 决定 Tesla 端点默认值。可选 jp / na / eu / cn（默认 jp）。
#   jp = 日本（APAC，复用北美 na 端点）  na = 北美  eu = 欧洲  cn = 中国
# 说明：Tesla Fleet API 无日本专属域名，日本属 APAC，走 na 端点。
REGION=jp

# Tesla OAuth
# 日本/海外从 https://developer.tesla.com 获取 Client ID/Secret（中国为 developer.tesla.cn）
TESLA_CLIENT_ID=your_tesla_client_id
TESLA_CLIENT_SECRET=your_tesla_client_secret
# 本地调试用 localhost；上线换为正式 HTTPS 域名（须与开发者门户登记的一致）
TESLA_REDIRECT_URI=http://localhost:8080/api/tesla/callback
TESLA_FRONTEND_CALLBACK_URL=http://localhost:5173/#/pages/callback/callback

# 可选：显式覆盖 Tesla 端点（留空则按 REGION 自动选择）
# TESLA_AUTH_URL=
# TESLA_TOKEN_URL=
# TESLA_FLEET_API_URL=
# TESLA_AUDIENCE=

# Vehicle Command Proxy (VCP)
# Leave empty to send commands directly via Fleet API (not recommended for China region)
# China region vehicle control commands (unlock, trunk, etc.) require VCP proxy
# tesla-http-proxy default: https://localhost:4443
TESLA_VCP_URL=https://127.0.0.1:4443

# Partner Domain (for pairing URL generation and Partner Account registration)
# Must match the domain registered in Tesla Developer Portal
TESLA_PARTNER_DOMAIN=your-domain.com

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=86400

# Tencent Map (optional)
TENCENT_MAP_KEY=your_tencent_map_key

# AI - Zhipu GLM (optional)
AI_API_KEY=
AI_MODEL=glm-4-flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Fleet Telemetry（实时流数据，需要 mTLS 证书和 Tesla 端配置）
# 启用后可获得 1-2 秒级实时数据（车速/充电功率等），不启用则通过轮询获取
# 注意：Telemetry 端口不能与 VCP 端口冲突，VCP 用 4443，Telemetry 用 8443
# 车辆通过 mTLS WebSocket 连接推送数据，必须配置 TLS 证书
# 证书要求：服务端证书的 CN 必须与 TELEMETRY_HOSTNAME 匹配
TELEMETRY_ENABLED=false
TELEMETRY_LISTEN_ADDR=:8443
TELEMETRY_HOSTNAME=your-domain.com
TELEMETRY_PRIVATE_KEY=
# 证书自动同步（启动时从宝塔证书目录和 VCP 密钥目录同步到 certs/）
# 启用后可直接 ./tesla-server 启动，无需 start.sh
CERT_SYNC_ENABLED=true
# VCP ECDSA 私钥目录（含 private.pem）
CERT_SYNC_VCP_KEYS_DIR=/opt/tesla-vcp/keys
# 宝塔 Let's Encrypt 证书源目录（含 fullchain.pem 和 privkey.pem）
CERT_SYNC_SRC_DIR=/www/server/panel/vhost/cert/your-domain.com
# 证书目标目录（留空则自动使用可执行文件同目录下的 certs/）
CERT_SYNC_DST_DIR=
